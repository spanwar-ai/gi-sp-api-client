{
  "name": "gi-sp-rest-soap-client",
  "displayName": "GI-SP REST & SOAP Client",
  "description": "REST and SOAP API client for VS Code with OAuth2 (Client Credentials, Authorization Code, Password). Postman / Thunder Client / Insomnia alternative with collections, environments, history, and cURL / Business Central AL code generation.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "sonu-panwar",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "keywords": [
    "rest client",
    "api client",
    "soap client",
    "soap",
    "api",
    "rest",
    "http",
    "oauth2",
    "postman",
    "thunder client",
    "insomnia",
    "curl",
    "request",
    "testing"
  ],
  "icon": "resources/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "aavamiRest.open",
        "title": "GI-SP REST & SOAP Client: Open"
      },
      {
        "command": "aavamiRest.newRequest",
        "title": "GI-SP REST & SOAP Client: New Request"
      },
      {
        "command": "aavamiRest.saveRequest",
        "title": "GI-SP REST & SOAP Client: Save Request"
      },
      {
        "command": "aavamiRest.importCollection",
        "title": "GI-SP REST & SOAP Client: Import Collection"
      },
      {
        "command": "aavamiRest.exportCollection",
        "title": "GI-SP REST & SOAP Client: Export Collection"
      },
      {
        "command": "aavamiRest.newCollection",
        "title": "GI-SP REST & SOAP Client: New Collection"
      },
      {
        "command": "aavamiRest.newEnvironment",
        "title": "GI-SP REST & SOAP Client: New Environment"
      },
      {
        "command": "aavamiRest.clearHistory",
        "title": "GI-SP REST & SOAP Client: Clear History"
      },
      {
        "command": "aavamiRest.resetActivation",
        "title": "GI-SP REST & SOAP Client: Reset Activation"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aavamiRest",
          "title": "GI-SP REST & SOAP Client",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aavamiRest": [
        {
          "type": "webview",
          "id": "aavamiRest.sidebarView",
          "name": "GI-SP REST & SOAP Client"
        }
      ]
    },
    "configuration": {
      "title": "GI-SP REST & SOAP Client",
      "properties": {
        "aavamiRest.requestTimeout": {
          "type": "number",
          "default": 30000,
          "description": "Default request timeout in milliseconds"
        },
        "aavamiRest.maxHistoryEntries": {
          "type": "number",
          "default": 500,
          "description": "Maximum number of history entries to keep"
        },
        "aavamiRest.followRedirects": {
          "type": "boolean",
          "default": true,
          "description": "Automatically follow HTTP redirects"
        },
        "aavamiRest.sslVerification": {
          "type": "boolean",
          "default": true,
          "description": "Enable SSL certificate verification"
        },
        "aavamiRest.maxResponseSize": {
          "type": "number",
          "default": 10485760,
          "description": "Maximum response size in bytes (default 10MB)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "build:extension": "node esbuild.js --production",
    "build:webview": "cd webview-ui && npm run build",
    "build": "npm run build:webview && npm run build:extension",
    "dev": "npm run watch",
    "lint": "eslint src --ext ts",
    "package": "vsce package"
  },
  "dependencies": {
    "@azure/msal-node": "^2.6.0",
    "axios": "^1.6.0",
    "form-data": "^4.0.5",
    "nodemailer": "^8.0.9",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/nodemailer": "^8.0.0",
    "@types/uuid": "^9.0.0",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.19.0",
    "typescript": "^5.3.0"
  }
}